{
  "name": "pi-codebuffer",
  "version": "0.3.0",
  "description": "Persistent revisioned source buffers for Pi's built-in CodeMode.",
  "type": "module",
  "license": "MIT",
  "author": "Jacek Yang",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jacek4yang/pi-codebuffer.git"
  },
  "engines": {
    "node": ">=24"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "codemode"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "exports": {
    ".": "./index.ts",
    "./editing": "./editing.ts"
  },
  "files": [
    "index.ts",
    "editing.ts",
    "third-party",
    "src",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "SECURITY.md",
    "docs"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "tsx --test test/*.test.ts",
    "check": "npm run typecheck && npm run lint && npm test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "smoke:install": "tsx scripts/install-smoke.ts",
    "benchmark": "tsx scripts/benchmark.ts"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.0.0",
    "@earendil-works/pi-coding-agent": "1.0.0",
    "@types/node": "^24.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.9.9",
    "tsx": "^4.20.0",
    "typebox": "1.3.27",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0"
  },
  "dependencies": {
    "acorn": "8.15.0"
  }
}
